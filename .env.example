# Nombres de las variables de entorno de TV Hub. NO escribas valores reales aquí.
# Local: copia este archivo a .env (ignorado por Git) y llena lo que necesites.
# Sin .env, el modo desarrollo usa valores locales seguros (MongoDB en localhost).
# Producción (Render): las variables se configuran en el panel/API de Render.
MONGODB_URI=
PORT=
NODE_ENV=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# Reportes (V5/V6). Sin SMTP_HOST se usa una cuenta temporal de Ethereal.
REPORT_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_ESCALATION_MINUTES=
REPORT_ESCALATION_CRON=
